# Environment Variables Template
# Copy this file to .env and fill in your values

# HuggingFace
HF_TOKEN=your_huggingface_token_here
HF_HOME=/data/debkanta/.cache/huggingface

# Model Cache Directory
MODEL_CACHE_DIR=/data/debkanta/.cache/models

# Results Directory
RESULTS_DIR=./results

# GPU Settings
CUDA_VISIBLE_DEVICES=0
TORCH_DTYPE=float16

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# Server Settings (IIT Kanpur Server)
SERVER_IP=172.31.100.251
SERVER_USER=debkanta
SERVER_DATA_DIR=/data/debkanta
